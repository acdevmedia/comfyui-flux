{
  "name": "Flux Image ComfyUI One-Click",
  "imageName": "ghcr.io/acdevmedia/flux-comfyui:2",
  "category": "NVIDIA",
  "containerDiskInGb": 200,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "isPublic": true,
  "isServerless": false,
  "ports": [
    "8188/http"
  ],
  "env": {
    "HF_TOKEN": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}",
    "HF_HOME": "/workspace/.cache/huggingface",
    "MODEL_MODE": "dev",
    "STUDIO_VERSION": "2",
    "PORT": "8000",
    "PORT_HEALTH": "8001"
  }
}

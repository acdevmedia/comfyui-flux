{
  "title": "Flux Image ComfyUI One-Click",
  "description": "FLUX.1, FLUX.2 and FLUX 3 Klein image generation and editing in ComfyUI, with simple, editable workflows. Defaults to FLUX.2 dev, which needs an 80 GB GPU; set MODEL_MODE=turbo for Klein on a 48 GB card.",
  "type": "serverless",
  "category": "image",
  "config": {
    "runsOn": "GPU",
    "endpointType": "LB",
    "containerDiskInGb": 200,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80,ADA_80_PRO",
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0"
    ],
    "env": [
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "HF_HOME",
        "value": "/workspace/.cache/huggingface"
      },
      {
        "key": "MODEL_MODE",
        "value": "dev"
      },
      {
        "key": "STUDIO_VERSION",
        "value": "2"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      }
    ]
  }
}
